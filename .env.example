# ---- General ----
ENVIRONMENT=development

# ---- Groq / LLM Vision ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-90b-vision-preview

# ---- Postgres (validation-service, exceptions-queue) ----
POSTGRES_USER=facturas_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=facturas_ia_erp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://facturas_user:change_me@postgres:5432/facturas_ia_erp

# ---- pgvector / RAG ----
VECTOR_COLLECTION_NAME=proveedores_ecuador
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Odoo (erp-connector-service) ----
ODOO_URL=http://odoo:8069
ODOO_DB=facturas_erp
ODOO_USERNAME=admin
ODOO_PASSWORD=change_me

# ---- Servicios internos (comunicacion entre microservicios) ----
EXTRACTION_SERVICE_URL=http://extraction-service:8001
VALIDATION_SERVICE_URL=http://validation-service:8002
ERP_CONNECTOR_SERVICE_URL=http://erp-connector-service:8003
EXCEPTIONS_QUEUE_URL=http://exceptions-queue:8004

# ---- Reglas de negocio Ecuador ----
IVA_RATE=0.15