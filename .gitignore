########################################
# Entornos virtuales Python (uno por servicio)
########################################
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
**/env/

########################################
# Python
########################################
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

########################################
# Variables de entorno / secretos
########################################
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*service-account*.json

########################################
# Docker
########################################
# (Dockerfile y docker-compose.yml SÍ se versionan)
*.pid
docker-compose.override.yml

########################################
# Bases de datos locales / volúmenes
########################################
*.sqlite3
*.db
pgdata/
postgres-data/
**/pgdata/
infra/postgres/data/

########################################
