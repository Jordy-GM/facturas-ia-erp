########################################
*.pt
*.pth
*.onnx
*.safetensors
.cache/
**/.cache/
models_cache/
huggingface_cache/
sentence_transformers_cache/

########################################
# Datos sensibles / facturas reales
########################################
# Las facturas sintéticas de ejemplo SÍ se versionan,
# pero cualquier dato real o generado en runtime, no.
data/facturas_reales/
data/uploads/
data/tmp/
data/*.log
!data/facturas_sinteticas/
!data/seed_proveedores.sql

########################################
# Logs
########################################
*.log
logs/
**/logs/

########################################
# IDEs / editores
########################################
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

